namespace no_pure_contingency_one_object

/-- In a model with one object, a true pure sentence is necessary (`Premodel.holdsAx_npc`). -/
theorem no_pure_contingency_r :
    Statements.Arguments.no_pure_contingency_one_object.no_pure_contingency_r := by
  intro Sig C _ A M hone
  rw [← AxiomSet.npc_eq_pureVersion]
  exact A.holdsAx_npc M

end no_pure_contingency_one_object

namespace barcan_d6

/-- Proposition D.6: in an ideally full model whose arrows out of the evaluation object are
surjective on the individuals, `BF_σ` at every type (`Premodel.ideal_bf_of_surjective`), read
in the pure reduct. -/
theorem barcan_r : Statements.Arguments.barcan_d6.barcan_r := by
  rintro Sig C _ A - ⟨W₀, De, ne, I, rfl, hs⟩
  rw [holdsAx_ofPure, reduct_ideal]
  rintro _ ⟨σ, -, rfl⟩
  exact Premodel.ideal_bf_of_surjective De hs σ

end barcan_d6

